APP_ENV=prod
APP_DEBUG=0

# Volume monté sur /data dans le conteneur. Dokploy doit conserver ce volume
# entre les déploiements, sinon les messages de contact sont effacés.
DATABASE_URL="sqlite:////data/app.db"

MAILER_DSN=null://null
DEFAULT_URI=https://alseqdev.cloud

# Remplacé dans Dokploy si le domaine change.
TRUSTED_HOSTS='^alseqdev\.cloud$'
